   (1) NewtonianFrame N % Ground frame
   (2) RigidFrame C1, C2 % Define intermediate frame for rotations
   (3) RigidBody C, X, Y, Z % Defines all bodies
   (4) System CUBE( C, X, Y, Z) % Defines all bodies
   (5) Variable H'', P'', S'', qX'', qY'', qZ''
   (6) Constant g, RX, RY, RZ, CX, CY, CZ
   (7) Point Scm
   (8) % Set component mass
   (9) C.SetMass(mC)
   (10) X.SetMass(mR)
   (11) Y.SetMass(mR)
   (12) Z.SetMass(mR)
   (13) % Define rotations
   (14) C1.RotateZ(N, H)
-> (15) C1_N = [cos(H), sin(H), 0;  -sin(H), cos(H), 0;  0, 0, 1]
-> (16) w_C1_N> = H'*C1z>
-> (17) alf_C1_N> = H''*C1z>

   (18) C2.Rotate(C1, Nx>, P)
-> (19) C2_C1[1,1] = cos(P) + cos(H)^2*(1-cos(P))
-> (20) C2_C1[1,2] = -sin(H)*cos(H)*(1-cos(P))
-> (21) C2_C1[1,3] = sin(H)*sin(P)
-> (22) C2_C1[2,1] = -sin(H)*cos(H)*(1-cos(P))
-> (23) C2_C1[2,2] = cos(P) + sin(H)^2*(1-cos(P))
-> (24) C2_C1[2,3] = sin(P)*cos(H)
-> (25) C2_C1[3,1] = -sin(H)*sin(P)
-> (26) C2_C1[3,2] = -sin(P)*cos(H)
-> (27) C2_C1[3,3] = cos(P)
-> (28) w_C2_C1> = P'*Nx>
-> (29) w_C2_N> = H'*C1z> + P'*Nx>
-> (30) alf_C2_C1> = P''*Nx>
-> (31) alf_C2_N> = H''*C1z> + P''*Nx> + H'*P'*Ny>

   (32) C.Rotate(C2, Ny>, S)
-> (33) C_C2[1,1] = cos(S) + sin(H)^2*cos(P)^2*(1-cos(S))
-> (34) C_C2[1,2] = sin(H)*cos(H)*cos(P)^2*(1-cos(S)) - sin(P)*sin(S)
-> (35) C_C2[1,3] = -cos(P)*(sin(S)*cos(H)+sin(H)*sin(P)*(1-cos(S)))
-> (36) C_C2[2,1] = sin(P)*sin(S) + sin(H)*cos(H)*cos(P)^2*(1-cos(S))
-> (37) C_C2[2,2] = cos(S) + cos(H)^2*cos(P)^2*(1-cos(S))
-> (38) C_C2[2,3] = cos(P)*(sin(H)*sin(S)-sin(P)*cos(H)*(1-cos(S)))
-> (39) C_C2[3,1] = cos(P)*(sin(S)*cos(H)-sin(H)*sin(P)*(1-cos(S)))
-> (40) C_C2[3,2] = -cos(P)*(sin(H)*sin(S)+sin(P)*cos(H)*(1-cos(S)))
-> (41) C_C2[3,3] = cos(S) + sin(P)^2*(1-cos(S))
-> (42) w_C_C2> = S'*Ny>
-> (43) w_C_N> = H'*C1z> + P'*Nx> + S'*Ny>
-> (44) alf_C_C2> = S''*Ny>
-> (45) alf_C_N> = (P'*S'+H'')*C1z> + (P''-H'*S')*Nx> + (H'*P'+S'')*Ny>

   (46) X.RotateX(C, qX)
-> (47) X_C = [1, 0, 0;  0, cos(qX), sin(qX);  0, -sin(qX), cos(qX)]
-> (48) w_X_C> = qX'*Xx>
-> (49) w_X_N> = H'*C1z> + P'*Nx> + S'*Ny> + qX'*Xx>
-> (50) alf_X_C> = qX''*Xx>
-> (51) alf_X_N> = (P'*S'+H'')*C1z> + (P''-H'*S')*Nx> + (H'*P'+S'')*Ny> + qX''*Xx>
        - qX'*((sin(P)*cos(qX)+sin(qX)*cos(H)*cos(P))*S'-(sin(S)*cos(P)*cos(qX)
        +sin(qX)*(sin(H)*cos(S)-sin(P)*sin(S)*cos(H)))*P'-(cos(P)*cos(qX)*cos(S)
        -sin(qX)*(sin(H)*sin(S)+sin(P)*cos(H)*cos(S)))*H')*Xy> + qX'*((sin(P)*
        sin(qX)-cos(H)*cos(P)*cos(qX))*S'-(sin(qX)*cos(P)*cos(S)+cos(qX)*(sin(H)
        *sin(S)+sin(P)*cos(H)*cos(S)))*H'-(sin(qX)*sin(S)*cos(P)-cos(qX)*(sin(H)
        *cos(S)-sin(P)*sin(S)*cos(H)))*P')*Xz>

   (52) Y.RotateY(C, qY)
-> (53) Y_C = [cos(qY), 0, -sin(qY);  0, 1, 0;  sin(qY), 0, cos(qY)]
-> (54) w_Y_C> = qY'*Yy>
-> (55) w_Y_N> = H'*C1z> + P'*Nx> + S'*Ny> + qY'*Yy>
-> (56) alf_Y_C> = qY''*Yy>
-> (57) alf_Y_N> = (P'*S'+H'')*C1z> + (P''-H'*S')*Nx> + (H'*P'+S'')*Ny> + qY'*(
        (sin(P)*cos(qY)-sin(H)*sin(qY)*cos(P))*S'-(sin(S)*cos(P)*cos(qY)+sin(
        qY)*(cos(H)*cos(S)+sin(H)*sin(P)*sin(S)))*P'-(cos(P)*cos(qY)*cos(S)-sin
        (qY)*(sin(S)*cos(H)-sin(H)*sin(P)*cos(S)))*H')*Yx> + qY''*Yy> + qY'*((
        sin(P)*sin(qY)+sin(H)*cos(P)*cos(qY))*S'-(sin(qY)*sin(S)*cos(P)-cos(qY)
        *(cos(H)*cos(S)+sin(H)*sin(P)*sin(S)))*P'-(sin(qY)*cos(P)*cos(S)+cos(
        qY)*(sin(S)*cos(H)-sin(H)*sin(P)*cos(S)))*H')*Yz>

   (58) Z.RotateZ(C, qZ)
-> (59) Z_C = [cos(qZ), sin(qZ), 0;  -sin(qZ), cos(qZ), 0;  0, 0, 1]
-> (60) w_Z_C> = qZ'*Zz>
-> (61) w_Z_N> = H'*C1z> + P'*Nx> + S'*Ny> + qZ'*Zz>
-> (62) alf_Z_C> = qZ''*Zz>
-> (63) alf_Z_N> = (P'*S'+H'')*C1z> + (P''-H'*S')*Nx> + (H'*P'+S'')*Ny> - qZ'*(
        (sin(qZ)*(cos(H)*cos(S)+sin(H)*sin(P)*sin(S))+cos(qZ)*(sin(H)*cos(S)-
        sin(P)*sin(S)*cos(H)))*P'-cos(P)*cos(H+qZ)*S'-(cos(qZ)*(sin(H)*sin(S)+
        sin(P)*cos(H)*cos(S))+sin(qZ)*(sin(S)*cos(H)-sin(H)*sin(P)*cos(S)))*H')*Zx>
        - qZ'*(cos(P)*sin(H+qZ)*S'+(sin(qZ)*(sin(H)*sin(S)+sin(P)*cos(H)*cos(S))
        -cos(qZ)*(sin(S)*cos(H)-sin(H)*sin(P)*cos(S)))*H'+(cos(qZ)*(cos(H)*cos(
        S)+sin(H)*sin(P)*sin(S))-sin(qZ)*(sin(H)*cos(S)-sin(P)*sin(S)*cos(H)))*
        P')*Zy> + qZ''*Zz>

   (64) % Define distances between points
   (65) P_No_Ccm> = CZ*Cx> + CX*Cy> - CY*Cz>
-> (66) P_No_Ccm> = CZ*Cx> + CX*Cy> - CY*Cz>

   (67) P_No_Xcm> = -RY*Cz> + RX*Cy> + RZ*Cx>
-> (68) P_No_Xcm> = RZ*Cx> + RX*Cy> - RY*Cz>

   (69) P_No_Ycm> = -RX*Cz> + RZ*Cy> + RY*Cx>
-> (70) P_No_Ycm> = RY*Cx> + RZ*Cy> - RX*Cz>

   (71) P_No_Zcm> = -RX*Cz> + RY*Cy> + RX*Cx>
-> (72) P_No_Zcm> = RX*Cx> + RY*Cy> - RX*Cz>

   (73) P_No_Scm> = (1/(mC + 3*mR))*(mR*P_No_Xcm> + mR*P_No_Ycm> + mR*P_No_Zcm> + mC*P_No_Ccm>)
-> (74) P_No_Scm> = (mC*CZ+mR*RX+mR*RY+mR*RZ)/(mC+3*mR)*Cx> + (mC*CX+mR*RX+mR*
        RY+mR*RZ)/(mC+3*mR)*Cy> - (mC*CY+mR*RY+2*mR*RX)/(mC+3*mR)*Cz>

   (75) % Find velocities of All CMs
   (76) v_No_N> = 0>
-> (77) v_No_N> = 0>

   (78) v_No_C> = 0>
-> (79) v_No_C> = 0>

   (80) Ccm.SetVelocity(N, No)
-> (81) v_Ccm_N> = (CX*(sin(P)*S'-sin(S)*cos(P)*P'-cos(P)*cos(S)*H')-CY*(cos(H)
        *cos(P)*S'+(sin(H)*sin(S)+sin(P)*cos(H)*cos(S))*H'-(sin(H)*cos(S)-sin(P)
        *sin(S)*cos(H))*P'))*Cx> + (CY*(sin(H)*cos(P)*S'+(cos(H)*cos(S)+sin(H)*
        sin(P)*sin(S))*P'-(sin(S)*cos(H)-sin(H)*sin(P)*cos(S))*H')-CZ*(sin(P)*
        S'-sin(S)*cos(P)*P'-cos(P)*cos(S)*H'))*Cy> + (CX*(sin(H)*cos(P)*S'+(cos
        (H)*cos(S)+sin(H)*sin(P)*sin(S))*P'-(sin(S)*cos(H)-sin(H)*sin(P)*cos(S))
        *H')-CZ*(cos(H)*cos(P)*S'+(sin(H)*sin(S)+sin(P)*cos(H)*cos(S))*H'-(sin(
        H)*cos(S)-sin(P)*sin(S)*cos(H))*P'))*Cz>

   (82) Xcm.SetVelocity(N, No)
-> (83) v_Xcm_N> = (RX*(sin(P)*S'-sin(S)*cos(P)*P'-cos(P)*cos(S)*H')-RY*(cos(H)
        *cos(P)*S'+(sin(H)*sin(S)+sin(P)*cos(H)*cos(S))*H'-(sin(H)*cos(S)-sin(P)
        *sin(S)*cos(H))*P'))*Cx> + (RY*(sin(H)*cos(P)*S'+(cos(H)*cos(S)+sin(H)*
        sin(P)*sin(S))*P'-(sin(S)*cos(H)-sin(H)*sin(P)*cos(S))*H')-RZ*(sin(P)*
        S'-sin(S)*cos(P)*P'-cos(P)*cos(S)*H'))*Cy> + (RX*(sin(H)*cos(P)*S'+(cos
        (H)*cos(S)+sin(H)*sin(P)*sin(S))*P'-(sin(S)*cos(H)-sin(H)*sin(P)*cos(S))
        *H')-RZ*(cos(H)*cos(P)*S'+(sin(H)*sin(S)+sin(P)*cos(H)*cos(S))*H'-(sin(
        H)*cos(S)-sin(P)*sin(S)*cos(H))*P'))*Cz>

   (84) Ycm.SetVelocity(N, No)
-> (85) v_Ycm_N> = (RZ*(sin(P)*S'-sin(S)*cos(P)*P'-cos(P)*cos(S)*H')-RX*(cos(H)
        *cos(P)*S'+(sin(H)*sin(S)+sin(P)*cos(H)*cos(S))*H'-(sin(H)*cos(S)-sin(P)
        *sin(S)*cos(H))*P'))*Cx> + (RX*(sin(H)*cos(P)*S'+(cos(H)*cos(S)+sin(H)*
        sin(P)*sin(S))*P'-(sin(S)*cos(H)-sin(H)*sin(P)*cos(S))*H')-RY*(sin(P)*
        S'-sin(S)*cos(P)*P'-cos(P)*cos(S)*H'))*Cy> + (RZ*(sin(H)*cos(P)*S'+(cos
        (H)*cos(S)+sin(H)*sin(P)*sin(S))*P'-(sin(S)*cos(H)-sin(H)*sin(P)*cos(S))
        *H')-RY*(cos(H)*cos(P)*S'+(sin(H)*sin(S)+sin(P)*cos(H)*cos(S))*H'-(sin(
        H)*cos(S)-sin(P)*sin(S)*cos(H))*P'))*Cz>

   (86) Zcm.SetVelocity(N, No)
-> (87) v_Zcm_N> = (RY*(sin(P)*S'-sin(S)*cos(P)*P'-cos(P)*cos(S)*H')-RX*(cos(H)
        *cos(P)*S'+(sin(H)*sin(S)+sin(P)*cos(H)*cos(S))*H'-(sin(H)*cos(S)-sin(P)
        *sin(S)*cos(H))*P'))*Cx> + RX*(sin(H)*cos(P)*S'+sin(S)*cos(P)*P'+cos(P)
        *cos(S)*H'+(cos(H)*cos(S)+sin(H)*sin(P)*sin(S))*P'-sin(P)*S'-(sin(S)*
        cos(H)-sin(H)*sin(P)*cos(S))*H')*Cy> + (RY*(sin(H)*cos(P)*S'+(cos(H)*
        cos(S)+sin(H)*sin(P)*sin(S))*P'-(sin(S)*cos(H)-sin(H)*sin(P)*cos(S))*
        H')-RX*(cos(H)*cos(P)*S'+(sin(H)*sin(S)+sin(P)*cos(H)*cos(S))*H'-(sin(H)
        *cos(S)-sin(P)*sin(S)*cos(H))*P'))*Cz>

   (88) % Set inertia dyadics
   (89) C.SetInertia(No, CIX, CIY, CIZ)% CIXY, CIYZ, CIXZ) % Cube frame about No
   (90) X.SetInertia(Xcm, RI, 0, 0) % X Rotor about Xcm
   (91) Y.SetInertia(Ycm, 0, RI, 0) % Y Rotor about Xcm NEED TO DEFINE THESE IN THE C Frame so there is no rotation matrix needed
   (92) Z.SetInertia(Zcm, 0, 0, RI) % Z Rotor about Xcm
   (93) % C.GetAngularMomentum(No)
   (94) % X.GetAngularMomentum(No)
   (95) % Y.GetAngularMomentum(No)
   (96) % Z.GetAngularMomentum(No)
   (97) H_S_No_N> = CUBE.GetAngularMomentum(No)
-> (98) H_S_No_N> = (CIX*(sin(H)*cos(P)*S'+(cos(H)*cos(S)+sin(H)*sin(P)*sin(S))
        *P'-(sin(S)*cos(H)-sin(H)*sin(P)*cos(S))*H')+RI*(qX'+sin(H)*cos(P)*S'+(
        cos(H)*cos(S)+sin(H)*sin(P)*sin(S))*P'-(sin(S)*cos(H)-sin(H)*sin(P)*cos
        (S))*H')+mR*(RX^2*(sin(S)*cos(P)*P'+cos(P)*cos(S)*H'+3*sin(H)*cos(P)*
        S'+3*(cos(H)*cos(S)+sin(H)*sin(P)*sin(S))*P'-sin(P)*S'-3*(sin(S)*cos(H)
        -sin(H)*sin(P)*cos(S))*H')-RY*(RX*(cos(H)*cos(P)*S'+(sin(H)*sin(S)+sin(
        P)*cos(H)*cos(S))*H'-(sin(H)*cos(S)-sin(P)*sin(S)*cos(H))*P')-2*RY*(sin
        (H)*cos(P)*S'+(cos(H)*cos(S)+sin(H)*sin(P)*sin(S))*P'-(sin(S)*cos(H)-
        sin(H)*sin(P)*cos(S))*H')))-mR*RZ*(RY*(sin(P)*S'-sin(S)*cos(P)*P'-cos(P)
        *cos(S)*H')+RX*(cos(H)*cos(P)*S'+(sin(H)*sin(S)+sin(P)*cos(H)*cos(S))*
        H'-(sin(H)*cos(S)-sin(P)*sin(S)*cos(H))*P'))-mR*(RX*RY*(sin(P)*S'-sin(S)
        *cos(P)*P'-cos(P)*cos(S)*H')+RZ*(RY*(cos(H)*cos(P)*S'+(sin(H)*sin(S)+
        sin(P)*cos(H)*cos(S))*H'-(sin(H)*cos(S)-sin(P)*sin(S)*cos(H))*P')-RZ*(
        sin(H)*cos(P)*S'+(cos(H)*cos(S)+sin(H)*sin(P)*sin(S))*P'-(sin(S)*cos(H)
        -sin(H)*sin(P)*cos(S))*H'))))*Cx> + (CIY*(cos(H)*cos(P)*S'+(sin(H)*sin(
        S)+sin(P)*cos(H)*cos(S))*H'-(sin(H)*cos(S)-sin(P)*sin(S)*cos(H))*P')+
        RI*(qY'+cos(H)*cos(P)*S'+(sin(H)*sin(S)+sin(P)*cos(H)*cos(S))*H'-(sin(H)
        *cos(S)-sin(P)*sin(S)*cos(H))*P')+mR*RX*(3*RX*(cos(H)*cos(P)*S'+(sin(H)
        *sin(S)+sin(P)*cos(H)*cos(S))*H'-(sin(H)*cos(S)-sin(P)*sin(S)*cos(H))*
        P')-2*RY*(sin(P)*S'-sin(S)*cos(P)*P'-cos(P)*cos(S)*H')-RY*(sin(H)*cos(P)
        *S'+(cos(H)*cos(S)+sin(H)*sin(P)*sin(S))*P'-(sin(S)*cos(H)-sin(H)*sin(P)
        *cos(S))*H'))+mR*(2*RY^2*(cos(H)*cos(P)*S'+(sin(H)*sin(S)+sin(P)*cos(H)
        *cos(S))*H'-(sin(H)*cos(S)-sin(P)*sin(S)*cos(H))*P')-RZ*(RX*(sin(H)*cos
        (P)*S'+(cos(H)*cos(S)+sin(H)*sin(P)*sin(S))*P'-(sin(S)*cos(H)-sin(H)*
        sin(P)*cos(S))*H')-RZ*(cos(H)*cos(P)*S'+(sin(H)*sin(S)+sin(P)*cos(H)*
        cos(S))*H'-(sin(H)*cos(S)-sin(P)*sin(S)*cos(H))*P')))-mR*RZ*(RX*(sin(P)
        *S'-sin(S)*cos(P)*P'-cos(P)*cos(S)*H')+RY*(sin(H)*cos(P)*S'+(cos(H)*cos
        (S)+sin(H)*sin(P)*sin(S))*P'-(sin(S)*cos(H)-sin(H)*sin(P)*cos(S))*H')))*Cy>
        + (mR*RX^2*(sin(H)*cos(P)*S'+2*sin(S)*cos(P)*P'+2*cos(P)*cos(S)*H'+(cos
        (H)*cos(S)+sin(H)*sin(P)*sin(S))*P'-2*sin(P)*S'-(sin(S)*cos(H)-sin(H)*
        sin(P)*cos(S))*H')+mR*(RX*RZ*(cos(H)*cos(P)*S'+(sin(H)*sin(S)+sin(P)*
        cos(H)*cos(S))*H'-(sin(H)*cos(S)-sin(P)*sin(S)*cos(H))*P')-RY*(2*RY*(
        sin(P)*S'-sin(S)*cos(P)*P'-cos(P)*cos(S)*H')-RX*(sin(H)*cos(P)*S'+(cos(
        H)*cos(S)+sin(H)*sin(P)*sin(S))*P'-(sin(S)*cos(H)-sin(H)*sin(P)*cos(S))
        *H')))+mR*(2*RX*RY*(cos(H)*cos(P)*S'+(sin(H)*sin(S)+sin(P)*cos(H)*cos(S))
        *H'-(sin(H)*cos(S)-sin(P)*sin(S)*cos(H))*P')-RZ*(2*RZ*(sin(P)*S'-sin(S)
        *cos(P)*P'-cos(P)*cos(S)*H')-RY*(sin(H)*cos(P)*S'+(cos(H)*cos(S)+sin(H)
        *sin(P)*sin(S))*P'-(sin(S)*cos(H)-sin(H)*sin(P)*cos(S))*H')))-CIZ*(sin(
        P)*S'-sin(S)*cos(P)*P'-cos(P)*cos(S)*H')-RI*(sin(P)*S'-qZ'-sin(S)*cos(P)
        *P'-cos(P)*cos(S)*H'))*Cz>

   (99) % Forces on system
   (100) FG_N> = -(mC+3*mR)*g*Ny>
-> (101) FG_N> = -(mC+3*mR)*g*Ny>

   (102) M_FG_No_N> = Cross(P_No_Scm>, FG_N>)
-> (103) M_FG_No_N> = g*((mC*CX+mR*RX+mR*RY+mR*RZ)*(sin(H)*sin(S)+sin(P)*cos(H)
         *cos(S))-(mC*CY+mR*RY+2*mR*RX)*cos(P)*cos(S)-(mC*CZ+mR*RX+mR*RY+mR*RZ)
         *(sin(S)*cos(H)-sin(H)*sin(P)*cos(S)))*Nx> + g*((mC*CY+mR*RY+2*mR*RX)*
         cos(P)*(cos(H)*(sin(H)*sin(P)*cos(H)^2*(1-cos(P))*(1-cos(S))+(cos(P)+
         cos(H)^2*(1-cos(P)))*(sin(S)*cos(H)-sin(H)*sin(P)*(1-cos(S))))+sin(H)*
         ((cos(P)+sin(H)^2*(1-cos(P)))*(sin(H)*sin(S)+sin(P)*cos(H)*(1-cos(S)))
         +sin(H)*cos(H)*(1-cos(P))*(2*sin(S)*cos(H)-sin(H)*sin(P)*(1-cos(S)))))
         +(mC*CX+mR*RX+mR*RY+mR*RZ)*(sin(H)*((cos(P)+sin(H)^2*(1-cos(P)))*(cos(
         S)+cos(H)^2*cos(P)^2*(1-cos(S)))-sin(H)*cos(H)*(1-cos(P))*(sin(P)*sin(
         S)+sin(H)*cos(H)*cos(P)^2*(1-cos(S))))+cos(H)*(sin(H)*cos(H)*(1-cos(P))
         *(cos(S)+cos(H)^2*cos(P)^2*(1-cos(S)))-(cos(P)+cos(H)^2*(1-cos(P)))*(
         sin(P)*sin(S)+sin(H)*cos(H)*cos(P)^2*(1-cos(S)))))-(mC*CZ+mR*RX+mR*RY+
         mR*RZ)*(sin(H)*(sin(H)*cos(H)*(1-cos(P))*(cos(S)+sin(H)^2*cos(P)^2*(1-
         cos(S)))+(cos(P)+sin(H)^2*(1-cos(P)))*(sin(P)*sin(S)-sin(H)*cos(H)*cos
         (P)^2*(1-cos(S))))+cos(H)*((cos(P)+cos(H)^2*(1-cos(P)))*(cos(S)+sin(H)^2
         *cos(P)^2*(1-cos(S)))+sin(H)*cos(H)*(1-cos(P))*(sin(P)*sin(S)-sin(H)*
         cos(H)*cos(P)^2*(1-cos(S))))))*Nz>

   (104) % Solve system of equations
   (105) zero[1] = Dot(DT(H_S_No_N>, N ) - M_FG_No_N>, Nz>)
-> (106) zero[1] = (sin(S)*cos(H)-sin(H)*sin(P)*cos(S))*((cos(H)*cos(P)*S'+(sin
         (H)*sin(S)+sin(P)*cos(H)*cos(S))*H'-(sin(H)*cos(S)-sin(P)*sin(S)*cos(H))
         *P')*(CIZ*(sin(P)*S'-sin(S)*cos(P)*P'-cos(P)*cos(S)*H')+RI*(sin(P)*S'-
         qZ'-sin(S)*cos(P)*P'-cos(P)*cos(S)*H')-mR*RX^2*(sin(H)*cos(P)*S'+2*sin
         (S)*cos(P)*P'+2*cos(P)*cos(S)*H'+(cos(H)*cos(S)+sin(H)*sin(P)*sin(S))*
         P'-2*sin(P)*S'-(sin(S)*cos(H)-sin(H)*sin(P)*cos(S))*H')-mR*(RX*RZ*(cos
         (H)*cos(P)*S'+(sin(H)*sin(S)+sin(P)*cos(H)*cos(S))*H'-(sin(H)*cos(S)-
         sin(P)*sin(S)*cos(H))*P')-RY*(2*RY*(sin(P)*S'-sin(S)*cos(P)*P'-cos(P)*
         cos(S)*H')-RX*(sin(H)*cos(P)*S'+(cos(H)*cos(S)+sin(H)*sin(P)*sin(S))*
         P'-(sin(S)*cos(H)-sin(H)*sin(P)*cos(S))*H')))-mR*(2*RX*RY*(cos(H)*cos(
         P)*S'+(sin(H)*sin(S)+sin(P)*cos(H)*cos(S))*H'-(sin(H)*cos(S)-sin(P)*
         sin(S)*cos(H))*P')-RZ*(2*RZ*(sin(P)*S'-sin(S)*cos(P)*P'-cos(P)*cos(S)*
